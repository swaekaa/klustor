# Environment Variables for THE PHOTO NEVER LIES
# Copy this file to .env and fill in your values

# ============================================================
# AI ASSISTANT (OPTIONAL)
# The application works fully without these.
# The AI assistant shows deterministic fallback responses
# if no API key is provided.
# ============================================================

# AI provider: "gemini" or "openai"
VITE_AI_PROVIDER=gemini

# Your AI API key (optional)
VITE_AI_API_KEY=your_api_key_here

# ============================================================
# STORAGE (OPTIONAL)
# Currently uses localStorage. For production persistence,
# configure a Supabase project.
# ============================================================

# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here
